{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--user-data-dir=.playwright-mcp"
      ]
    },
    "playwright-electron": {
      "command": "bun",
      "args": [
        "run",
        "tools/mcp-playwright-electron.ts"
      ]
    }
  }
}
