{
	"name": "agentz",
	"version": "0.0.12",
	"description": "agentz multi-terminal workspace",
	"main": ".electron/index.js",
	"scripts": {
		"start": "bun run dev",
		"dev": "bun run scripts/dev.ts",
		"dev:hmr": "bun run dev",
		"dev:launch": "bun run scripts/dev-launch.ts",
		"hmr": "vite --host 127.0.0.1 --port 5173",
		"electron:build-main": "bun run scripts/build-electron.ts",
		"electron:watch": "bun run scripts/electron-watch.ts",
		"electron:run": "bun run scripts/electron-run.ts",
		"build:desktop": "bun run scripts/build-desktop.ts",
		"native:build": "bun run native:build:host",
		"native:build:host": "bun run scripts/native-build-host.ts",
		"release:stable": "bun run build:desktop && electron-builder --publish never"
	},
	"dependencies": {
		"@xterm/addon-canvas": "^0.7.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-serialize": "^0.14.0",
		"@xterm/addon-webgl": "^0.19.0",
		"@xterm/headless": "^6.0.0",
		"electron-updater": "^6.8.3",
		"ghostty-opentui": "^1.4.5",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"selfsigned": "^5.5.0",
		"ws": "^8.18.3",
		"xterm": "^5.3.0"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/node": "^22.15.21",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"electron": "^35.2.0",
		"electron-builder": "^25.1.8",
		"electronmon": "^2.0.2",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.4.16",
		"typescript": "^5.7.2",
		"vite": "^6.0.3",
		"wait-on": "^8.0.3"
	},
	"build": {
		"appId": "dev.agentz.desktop",
		"productName": "agentz",
		"executableName": "agentz",
		"publish": [
			{
				"provider": "github",
				"owner": "horvay",
				"repo": "agentz"
			}
		],
		"files": [
			".electron/**/*",
			"dist/**/*",
			"package.json"
		],
		"extraResources": [
			{
				"from": "src/native/zig-out/bin",
				"to": "bin",
				"filter": [
					"agentz-pty-host",
					"agentz-pty-host.exe"
				]
			}
		],
		"linux": {
			"category": "Development",
			"target": ["AppImage"]
		},
		"mac": {
			"target": ["dmg", "zip"],
			"category": "public.app-category.developer-tools",
			"notarize": true
		},
		"win": {
			"target": ["nsis"]
		},
		"npmRebuild": false
	}
}
